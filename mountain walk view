<script>

function copyText(id){

  const text = document.getElementById(id).innerText;

  navigator.clipboard.writeText(text).then(function(){

    alert('Prompt copied successfully!');

  }).catch(function(){

    alert('Unable to copy prompt.');

  });

}


function shareText(id,title){

  const text = document.getElementById(id).innerText;

  if(navigator.share){

    navigator.share({
      title:title,
      text:text,
      url:location.href
    });

  }else{

    navigator.clipboard.writeText(text);

    alert('Prompt copied!');

  }

}


function whatsappText(id){

  const text = document.getElementById(id).innerText;

  const message =
    'Check this jigsaw_fouji AI video prompt:\n\n' +
    text +
    '\n\n' +
    location.href;

  location.href =
    'https://wa.me/?text=' +
    encodeURIComponent(message);

}

</script>

